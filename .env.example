# Required to send the results email. Create a key in Resend (resend.com/api-keys).
RESEND_API_KEY=

# Who the email comes from. The domain must be verified in Resend.
RESULTS_FROM_EMAIL="Joe Heraldo <results@headtrashdojo.com>"
# Optional: where replies go.
RESULTS_REPLY_TO=

# Where the "Book your discovery webinar" button goes (your CloseEase booking page).
NEXT_PUBLIC_BOOKING_URL=

# The live site address, used for images and the "view your results online" link.
# On Vercel this is filled in automatically, so you can leave it empty there.
NEXT_PUBLIC_SITE_URL=

# Optional: CloseEase lead form address (https://<crm>/api/public/leads/<key>).
# Every person who asks for results then shows up as a lead, tagged with their top pattern and referral code.
CLOSEEASE_LEADS_URL=

# Optional: business mailing address shown in the email footer.
BUSINESS_ADDRESS=
